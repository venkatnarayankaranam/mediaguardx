SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

SIGHTENGINE_API_USER=your-sightengine-user-id
SIGHTENGINE_API_SECRET=your-sightengine-api-secret

PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Additional Configuration (optional - defaults shown)
CORS_ORIGINS=
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
REPORTS_DIR=reports
HEATMAPS_DIR=heatmaps
RATE_LIMIT_PER_MINUTE=60

# Admin Seed Credentials (used by seed.py)
ADMIN_EMAIL=admin@mediaguardx.com
ADMIN_PASSWORD=change-this-password
